___CSS_LOADER_EXPORT___.push([module.id, `.blog .container {
  max-width: 960px;
  margin: 0 auto;
  padding: 0 1.5rem; /* Add some padding for smaller screens */
}

article {
  background-color: white;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  border-radius: 8px;
  padding: 1.5rem;
  margin-bottom: 2rem;
}

@media (max-width: 768px) {
  article {
    padding: 1rem;
  }
}

article h3 {
  font-size: 1.5rem;
  color: #08347c;
}

article p {
  line-height: 1.6;
}

article p a {
  color: #007bff;
  text-decoration: underline;
}

article p a:hover {
  color: #0056b3;
}

article a.primary-cta {
  display: inline-block;
  margin-top: 1rem;
}

.article-meta {
  font-size: 0.9rem;
  color: #888;
  margin-bottom: 1rem;
}

hr {
  border: none;
  height: 1px;
  background-color: #eee;
  margin: 1.5rem 0;
}

article h4 {
  font-size: 1.2rem;
  color: #1a4a8a;
  margin-top: 2rem;
  margin-bottom: 1rem;
}

article ul {
  padding-left: 20px;
  margin-bottom: 1.5rem;
}

article li {
  margin-bottom: 0.5rem;
}

article blockquote {
  border-left: 4px solid #ccc;
  margin: 1.5rem 0;
  padding: 0.5rem 1.5rem;
  font-style: italic;
  color: #666;
}

/* Read More Button Styles */
.read-more-btn {
  color: rgb(187, 185, 185) !important;
  text-decoration: none;
  font-size: 1rem;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
  margin-top: 1rem;
}

.read-more-btn:hover {
  color: rgb(51, 51, 51);
}

.read-more-btn .chevron-icon {
  width: 18px; /* Adjust size as needed */
  height: 18px;
  margin-left: 0.3rem;
  transition: transform 0.3s ease;
}

.read-more-btn .chevron-icon.rotated {
  transform: rotate(180deg);
}

/* Hide extra content by default */
.article-content {
  max-height: 100px; /* Make the initial visible section even smaller */
  overflow: hidden;
  position: relative; /* Needed for the ::after pseudo-element */
  transition: max-height 0.5s ease-out;
}

/* Tapering effect */
.article-content::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 80px; /* Increase height of the fade effect for more tapering */
  background: linear-gradient(to top, white 0%, rgba(255, 255, 255, 0) 100%); /* Ensure full fade to white */
  pointer-events: none; /* Allow clicking through the overlay */
}

/* Remove tapering effect when expanded */
.article-content.expanded::after {
  display: none;
}

/* Show content when expanded */
.article-content.expanded {
  max-height: 2000px; /* Adjust this value based on your content length */
  transition: max-height 0.5s ease-in;
}

.blog .featured-image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 8px;
  margin: 1.5rem 0;
}

.blog article h2 a {
  color: #08347c;
}
