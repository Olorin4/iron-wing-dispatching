---
import { TURNSTILE_SITEKEY } from "../turnstile.js";
---

<footer class="site-footer">
    <div class="footer-content">
        <div class="footer-columns">
            <div>
                <h2>Contact</h2>
                <ul class="footer-links">
                    <li>
                        <a href="tel:+18178653016">
                            <img
                                src="/assets/images/phone-call.svg"
                                alt=""
                                width="18"
                                height="18"
                                loading="lazy" />
                            (817) 865-3016
                        </a>
                    </li>
                    <li>
                        <a href="mailto:info@iron-wing-dispatching.com">
                            info@iron-wing-dispatching.com
                        </a>
                    </li>
                </ul>
            </div>

            <div>
                <h2>Follow us</h2>
                <ul class="footer-links footer-social">
                    <li>
                        <a href="https://www.facebook.com/people/Iron-Wing-Dispatching/61596218484100/">
                            <img
                                src="/assets/images/facebook_32.png"
                                alt=""
                                width="20"
                                height="20"
                                loading="lazy" />
                            <span>Facebook</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://www.linkedin.com/company/145383398/">
                            <img
                                src="/assets/images/linkedin_32.png"
                                alt=""
                                width="20"
                                height="20"
                                loading="lazy" />
                            <span>LinkedIn</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://www.instagram.com/iron.wing.dispatching/">
                            <img
                                src="/assets/images/instagram.svg"
                                alt=""
                                width="20"
                                height="20"
                                loading="lazy" />
                            <span>Instagram</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="footer-newsletter">
                <h2>Get Trucking Tips &amp; Updates</h2>
                <form id="newsletter-form">
                    <input
                        type="email"
                        id="newsletter-email"
                        name="email"
                        aria-label="Email address"
                        placeholder="Email address"
                        autocomplete="email"
                        required />
                    <button type="submit" class="secondary-cta">Subscribe</button>
                    <div
                        class="cf-turnstile"
                        data-sitekey={TURNSTILE_SITEKEY}
                        data-action="turnstile-spin-v1"
                        data-appearance="interaction-only">
                    </div>
                </form>
            </div>
        </div>

        <div class="footer-bottom">
            <small>&copy; {new Date().getFullYear()} Iron Wing Dispatching</small>
            <nav aria-label="Legal">
                <a href="/privacy-policy.html">Privacy Policy</a>
                <a href="/terms.html">Terms and Conditions</a>
            </nav>
        </div>
    </div>
</footer>

<script>
    import { handleNewsletterSignup } from "../newsletter.js";

    const init = () => handleNewsletterSignup();
    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", init);
    else init();
</script>
