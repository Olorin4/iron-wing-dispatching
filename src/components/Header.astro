---
// Set contactPopup on pages that include the contact popup (the home page);
// elsewhere the Contact button goes to the sign-up form.
const { contactPopup = false } = Astro.props;
---

<header>
            <div class="container">
                <div class="logo">
                    <a href="/">
                        <img
                            src="/assets/images/logo.webp"
                            width="350"
                            height="150"
                            alt="Iron Wing Dispatching logo" />
                    </a>
                </div>
                <div class="menu-wrapper">
                    <div class="contact-top">
                        <img
                            src="/assets/images/phone-call.svg"
                            alt="Call a dispatcher now!"
                            class="phone-icon" />
                        <a href="tel:+18178653016" class="phone-number">
                            (817) 865-3016
                        </a>
                    </div>
                    <button
                        class="hamburger"
                        aria-label="Toggle navigation"
                        data-darkreader-ignore>
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <nav class="nav-links">
                        <ul>
                            <li><a href="/#about">About</a></li>
                            <li><a href="/#services">Services</a></li>
                            <li><a href="/#pricing">Pricing</a></li>
                            <li><a href="/blog.html">Blog</a></li>
                            <!-- Contact link in a shiny silver button -->
                            <li>
                                <a
                                    href="/sign-up.html"
                                    class="secondary-cta"
                                    data-contact-trigger={contactPopup ? "" : undefined}>
                                    Contact
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </header>

<script>
    import { hamburgerMenu } from "../dom.js";

    const init = () => hamburgerMenu();
    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", init);
    else init();
</script>
