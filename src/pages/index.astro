---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../normalize.css";
import "../shared.css";
import "../styles.css";
import { POSTHOG_PROJECT_TOKEN } from "astro:env/client";
import { HERO_EXPERIMENT_ENABLED } from "astro:env/server";
import sha1Source from "js-sha1/build/sha1.min.js?raw";
import QuestionPopup from "../components/QuestionPopup.astro";
import { assignHero, HERO_FLAG } from "../heroAssignment.js";

const heroAssignmentScript = HERO_EXPERIMENT_ENABLED && POSTHOG_PROJECT_TOKEN && `(() => {
    const module = { exports: {} };
    ${sha1Source}
    (${assignHero.toString()})(
        ${JSON.stringify("ph_" + POSTHOG_PROJECT_TOKEN + "_posthog")},
        ${JSON.stringify(HERO_FLAG)},
        module.exports
    );
})();`;

const site = Astro.site.origin;
const title =
    "Truck Dispatch Service for Owner-Operators | Iron Wing Dispatching";
const structuredData = {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: "Iron Wing Dispatching",
    url: `${site}/`,
    logo: `${site}/assets/images/NewLogo.png`,
    description:
        "Truck dispatch service for owner-operators and small motor carriers: load sourcing, rate negotiation, route optimization and administrative support.",
    telephone: "+1-817-865-3016",
    email: "info@iron-wing-dispatching.com",
    areaServed: [
        { "@type": "Country", name: "United States" },
        { "@type": "Country", name: "Canada" },
    ],
    priceRange: "5%–10% of the rate confirmation total",
    sameAs: [
        "https://www.facebook.com/people/Iron-Wing-Dispatching/61596218484100/",
        "https://www.linkedin.com/company/145383398/",
    ],
};
---

<BaseLayout
    title={title}
    description="Truck dispatching by a former owner-operator. Load sourcing, rate negotiation, route planning and paperwork for owner-operators and small carriers. Plans from 5%."
    canonical={`${site}/`}
    contactPopup
>
    <Fragment slot="head">
        <!-- Psalm 127:1-2, “Unless the Lord builds the house, they labor in vain who build it; -->
        <meta name="robots" content="index, follow" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Iron Wing Dispatching" />
        <meta property="og:title" content={title} />
        <meta
            property="og:description"
            content="Dispatching by truckers, for truckers. Better loads, less paperwork, cancel anytime. Plans from 5%."
        />
        <meta property="og:url" content={`${site}/`} />
        <meta
            property="og:image"
            content={`${site}/assets/images/caleb-ruiter-EmEQ6kK_5P0-unsplash_1200.webp`}
        />
        <meta name="twitter:card" content="summary_large_image" />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
        />
        <!-- Select the hero before rendering either variant. -->
        <style is:inline>
            html:not([data-hero-variant="test"]) .hero-test,
            html[data-hero-variant="test"] .hero-control {
                display: none;
            }
        </style>
        {heroAssignmentScript && <script is:inline set:html={heroAssignmentScript} />}
    </Fragment>
<main>
            <!-- Hero Section -->
            <section class="hero">
                <img
                    src="/assets/images/caleb-ruiter-EmEQ6kK_5P0-unsplash_1200.webp"
                    srcset="
                        /assets/images/caleb-ruiter-EmEQ6kK_5P0-unsplash_420.webp   420w,
                        /assets/images/caleb-ruiter-EmEQ6kK_5P0-unsplash_600.webp   600w,
                        /assets/images/caleb-ruiter-EmEQ6kK_5P0-unsplash_800.webp   800w,
                        /assets/images/caleb-ruiter-EmEQ6kK_5P0-unsplash_1200.webp 1200w,
                        /assets/images/caleb-ruiter-EmEQ6kK_5P0-unsplash.webp      1800w
                    "
                    sizes="(max-width: 420px) 100vw, (max-width: 768px) 100vw, (max-width: 1200px) 75vw, 50vw"
                    alt="OTR owner-operator driving his truck hauling a load with a dry van trailer"
                    class="hero-image" />
                <div class="hero-text">
                    <h1 id="hero-title">
                        <span class="hero-control">Better Loads. Less Paperwork. From 5%.</span>
                        <span class="hero-test">Keep driving. We’ll find your next load.</span>
                    </h1>
                    <h2 id="hero-subtitle">
                        <span class="hero-control">We find and negotiate your loads, deal with the brokers and handle the paperwork so you can drive. Dispatch starts at 5% of the rate confirmation total. Cancel anytime.</span>
                        <span class="hero-test">Tell us where you want to run. Your dispatcher finds loads that fit your truck and schedule, negotiates the rate, and handles the booking. Dispatch starts at 5% of the rate confirmation total. Cancel anytime.</span>
                    </h2>
                    <div class="hero-actions">
                        <a href="#pricing" class="primary-cta" id="hero-cta">See dispatching rates</a>
                        <a href="/sign-up.html" class="hero-question" data-contact-trigger data-placement="hero">Ask a dispatcher</a>
                    </div>
                </div>
            </section>

            <section id="pricing" class="pricing">
                <h2>Pricing</h2>
                <p class="pricing-intro">
                    We charge a percentage of the agreed rate confirmation total on each load we book.
                    Fuel and other charges already included in that total count once.
                    We email an itemized weekly statement. <a href="/terms.html">Read the payment terms</a>.
                </p>
                <div class="container">
                    <div class="pricing-card">
                        <h3>Dispatch Essentials</h3>
                        <p class="plan-tagline">We find, negotiate and book freight. You handle billing.</p>
                        <div class="price">5%</div>
                        <a class="primary-cta" href="/sign-up.html?plan=ESSENTIAL" data-plan="ESSENTIAL">Apply for Essentials</a>
                        <ul>
                            <li>Load sourcing and rate negotiation</li>
                            <li>Routing around your equipment, lanes and schedule</li>
                            <li>Carrier packets and basic broker paperwork</li>
                            <li>Business-hours support</li>
                        </ul>
                    </div>
                    <div class="pricing-card featured">
                        <h3>Dispatch + Back Office</h3>
                        <p class="plan-tagline">We dispatch your truck and handle your invoicing and factoring submissions.</p>
                        <div class="price">10%</div>
                        <a class="primary-cta" href="/sign-up.html?plan=FULL_SERVICE" data-plan="FULL_SERVICE">Apply for Back Office</a>
                        <ul>
                            <li>Everything in Dispatch Essentials</li>
                            <li>Dedicated dispatcher and priority 24/7 support</li>
                            <li>Invoicing and factoring submissions</li>
                            <li>Detention and lumper claims and compliance assistance</li>
                        </ul>
                    </div>
                </div>
                <p class="fleet-note">
                    Running three or more trucks? <a href="/sign-up.html?plan=FLEET" data-plan="FLEET">Request a fleet quote</a> for either service.
                </p>
            </section>

            <!-- Services Section -->
            <section id="services" class="services">
                <a href="#services"><h1>What your dispatcher handles</h1></a>
                <div class="service-cards">
                    <!-- First 3 cards always visible -->
                    <!-- Card 1: Load Sourcing -->
                    <div class="card">
                        <div class="card-icon">
                            <img
                                src="/assets/images/truck.svg"
                                alt="A truck" />
                        </div>
                        <h3>Find the next load</h3>
                        <p>
                            We look at your equipment, where you unload and when you are ready. Then we find a load that fits and negotiate with the broker.
                        </p>
                    </div>
                    <!-- Card 2: Route Optimization -->
                    <div class="card">
                        <div class="card-icon">
                            <img
                                src="/assets/images/trending-up.svg"
                                alt="Optimize routing" />
                        </div>
                        <h3>Count the empty miles</h3>
                        <p>
                            For example, $1,525 over 600 total miles pays $2.54 per mile. $1,450 over 520 total miles pays $2.79 per mile. Your dispatcher compares both trips, including the miles you run empty.
                        </p>
                    </div>
                    <!-- Card 3: Administrative Support -->
                    <div class="card">
                        <div class="card-icon">
                            <img
                                src="/assets/images/clipboard.svg"
                                alt="paperwork" />
                        </div>
                        <h3>Handle the broker paperwork</h3>
                        <p>
                            We handle carrier packets and rate confirmations. Dispatch + Back Office also handles invoices and factoring submissions.
                        </p>
                    </div>
                </div>

                <!-- Hidden cards container -->
                <div class="hidden-services" style="max-height: 0">
                    <div class="service-cards hidden-cards">
                        <!-- Card 4: Driver Dispatching -->
                        <div class="card">
                            <div class="card-icon">
                                <img
                                    src="/assets/images/compass.svg"
                                    alt="Dispatch" />
                            </div>
                            <h3>Driver Dispatching</h3>
                            <p>
                                We provide rate confirmations and dispatch
                                instructions, keeping you focused on driving
                                your truck.
                            </p>
                        </div>
                        <!-- Card 5: Factoring Assistance -->
                        <div class="card">
                            <div class="card-icon">
                                <img
                                    src="/assets/images/dollar-sign.svg"
                                    alt="profits" />
                            </div>
                            <h3>Factoring Assistance</h3>
                            <p>
                                Dispatch + Back Office submits your paperwork to your factoring company.
                            </p>
                        </div>
                        <!-- Card 6: Compliance Management -->
                        <div class="card">
                            <div class="card-icon">
                                <!-- A shield/check icon -->
                                <svg
                                    width="40"
                                    height="40"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#08347c"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path
                                        d="M12 2l7 4v5c0 5.3-3.4 10-7 11c-3.6-1-7-5.7-7-11V6z"></path>
                                    <path d="M9 11l2 2l4-4"></path>
                                </svg>
                            </div>
                            <h3>Compliance Management</h3>
                            <p>
                                Dispatch + Back Office helps keep your carrier documents and certifications current.
                            </p>
                        </div>
                        <!-- Card 7: 24/7 Support -->
                        <div class="card">
                            <div class="card-icon">
                                <img
                                    src="/assets/images/headphones.svg"
                                    alt="trucker support" />
                            </div>
                            <h3>24/7 Support</h3>
                            <p>
                                Dispatch + Back Office includes priority 24/7 support. Essentials includes business-hours support.
                            </p>
                        </div>
                        <!-- Card 8: Lumper/Detention -->
                        <div class="card">
                            <div class="card-icon">
                                <!-- A clipboard or truck with a stopwatch icon -->
                                <svg
                                    width="40"
                                    height="40"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#08347c"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M9 1h6"></path>
                                    <path d="M12 4v1"></path>
                                    <circle cx="12" cy="14" r="8"></circle>
                                    <path d="M12 10v4h3"></path>
                                </svg>
                            </div>
                            <h3>Lumper/Detention</h3>
                            <p>
                                Dispatch + Back Office helps you submit lumper and detention claims.
                            </p>
                        </div>
                        <!-- Card 9: Dedicated Lanes -->
                        <div class="card">
                            <div class="card-icon">
                                <img
                                    src="/assets/images/map-pin.svg"
                                    alt="Securing contract directly with shippers" />
                            </div>
                            <h3>Dedicated Lanes</h3>
                            <p>
                                We can assist you in securing contracts directly
                                with shippers.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="show-more-container">
                    <a href="javascript:void(0)" class="show-more-link">
                        Show More Services
                        <img
                            src="/assets/images/chevron-down.svg"
                            alt="Show more dispatching services" />
                    </a>
                </div>
            </section>

            <!-- Sales Pitch Section -->
            <QuestionPopup />

            <!-- FAQ Section -->
            <section id="faq" class="faq">
                <a href="#faq"><h1>Common Questions</h1></a>
                <div class="faq-list">
                    <details>
                        <summary>What does the percentage apply to?</summary>
                        <p>
                            For new agreements, the fee applies to the agreed rate confirmation total. A $2,400 confirmation that includes $400 in fuel has the same fee as a flat $2,400 confirmation. Existing signed agreements keep their original terms.
                        </p>
                    </details>
                    <details>
                        <summary>Is there a contract?</summary>
                        <p>
                            There is a short service agreement to sign, but no
                            term commitment. If you are not satisfied with our
                            service, you can stop anytime by phone or email.
                        </p>
                    </details>
                    <details>
                        <summary>How do I pay you?</summary>
                        <p>
                            By card or by bank debit (ACH). When you sign the
                            service agreement, you can also grant us
                            payment authorization through Stripe with a few
                            clicks, and every Friday we charge
                            the fees for the loads delivered the week before,
                            Monday to Sunday, with an emailed statement of each
                            load and its fee. The fee is owed once a load is
                            delivered, whether or not you factor and even if
                            the broker pays late or does not pay. If you cancel
                            a load after accepting it, the fee is still
                            charged; if the broker or shipper cancels, there is
                            no fee.
                        </p>
                    </details>
                    <details>
                        <summary>Which equipment do you dispatch?</summary>
                        <p>Dry van, flatbed, reefer and power only.</p>
                    </details>
                    <details>
                        <summary>Where do you dispatch?</summary>
                        <p>
                            Across the lower 48 states, and cross-border to
                            Canada.
                        </p>
                    </details>
                    <details>
                        <summary>Do you work with new MC authorities?</summary>
                        <p>
                            Yes, from day one, with no minimum authority age.
                            Be aware that some brokers limit how much they book
                            with a new authority at first.
                        </p>
                    </details>
                    <details>
                        <summary>What happens after I apply?</summary>
                        <p>
                            We will reach out by phone or email to go over your
                            equipment, lanes and goals. It helps to have your MC
                            authority, insurance certificate and W-9 ready.
                        </p>
                    </details>
                    <details>
                        <summary>Do you work with fleets?</summary>
                        <p>
                            Yes. For 3 or more trucks, get in touch and we will
                            put together fleet pricing.
                        </p>
                    </details>
                </div>
            </section>



            <!-- About Us Section -->
            <section id="about" class="about">
                <img
                    src="/assets/images/josiah-farrow-ucuOscdCaO4-unsplash_1200.webp"
                    srcset="
                        /assets/images/josiah-farrow-ucuOscdCaO4-unsplash_420.webp   420w,
                        /assets/images/josiah-farrow-ucuOscdCaO4-unsplash_600.webp   600w,
                        /assets/images/josiah-farrow-ucuOscdCaO4-unsplash_800.webp   800w,
                        /assets/images/josiah-farrow-ucuOscdCaO4-unsplash_1200.webp 1200w,
                        /assets/images/josiah-farrow-ucuOscdCaO4-unsplash.webp      1800w
                    "
                    sizes="(max-width: 420px) 100vw, (max-width: 768px) 100vw, (max-width: 1200px) 75vw, 50vw"
                    alt="A heavy truck of a small motor carrier hauling a load with a reefer trailer"
                    class="about-image"
                    loading="lazy" />

                <div class="about-text">
                    <h2>About Iron Wing</h2>
                    <h3>By Truckers, For Truckers</h3>
                    <p>
                        At Iron Wing Dispatching, we specialize in providing
                        personalized dispatch services tailored to the unique
                        needs of owner-operators and small motor carriers. Our
                        mission is to maximize your profitability by finding the
                        best loads, negotiating with brokers, and handling the
                        logistics—so you can focus on driving.
                    </p>
                    <p>
                        What sets us apart is firsthand experience. Our founder
                        spent years behind the wheel as an owner-operator,
                        hauling freight over countless miles. He knows the long
                        hours, the tight delivery windows, the frustration of
                        deadhead miles and the constant balance between running
                        legal hours and chasing better-paying freight. We use
                        that insight to find loads that fit your trailer and
                        schedule, smooth out communication with brokers, and
                        keep your compliance paperwork current, so you are
                        never stranded without options.
                    </p>
                    <a
                        href="/sign-up.html"
                        id="contact-trigger"
                        class="primary-cta"
                        data-contact-trigger data-placement="about">
                        Ask a dispatcher
                    </a>
                </div>
                <div class="logo-overlay">
                    <img
                        src="/assets/images/NewLogo.png"
                        alt="Iron Wing Dispatching Services for Owner-Operators and small motor Carriers"
                        width="350"
                        height="117"
                        loading="lazy" />
                </div>
            </section>
        </main>
    <script>
        import "../index.js";
    </script>
</BaseLayout>
