---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuestionPopup from "../components/QuestionPopup.astro";
import "../normalize.css";
import "../shared.css";
import "../sign-up-form/sign-up.css";
import { TURNSTILE_SITEKEY } from "../turnstile.js";
---
<BaseLayout
    title="Apply for truck dispatching | Iron Wing Dispatching"
    description="Request a call or email about dispatching for your truck and lanes."
    contactPopup
>
    <main class="application">
        <section class="application-panel" aria-labelledby="application-title">
            <h1 id="application-title">Apply for dispatching</h1>
            <div id="offer-details" hidden>
                <h2>Black Friday · 3% Dispatch Essentials</h2>
                <p>New carriers can request this rate by November 30, 2026 at 11:59 p.m. Central. It applies to eligible loads we book through December 31, 2026, Central time. Loads booked starting January 1, 2027 are 5%.</p>
                <p>On a $2,400 confirmation including $400 in fuel, the fee is $72 at 3% or $120 at 5%. Dispatch + Back Office is $240 at 10%.</p>
            </div>
            <p id="offer-status" hidden></p>
            <p>A dispatcher will contact you about your truck and lanes. You can apply now and send documents later.</p>
            <p class="application-actions">
                <a href="#popup-overlay" data-contact-trigger data-placement="application" id="application-question">Ask a dispatcher</a>
                <a href="tel:+18178653016" data-phone-placement="application">Call (817) 865-3016</a>
            </p>
            <form id="sign-up-form">
                <label for="plan">Service</label>
                <select id="plan" name="plan">
                    <option value="DISCUSS">Discuss with dispatcher</option>
                    <option value="ESSENTIAL">Dispatch Essentials (5%)</option>
                    <option value="FULL_SERVICE">Dispatch + Back Office (10%)</option>
                    <option value="FLEET">Fleet pricing</option>
                </select>

                <label for="applicant-name">Your name</label>
                <input id="applicant-name" name="name" autocomplete="name" maxlength="100" required />

                <p id="contact-hint">Enter an email or callback number.</p>
                <div class="application-contact" aria-describedby="contact-hint">
                    <div>
                        <label for="applicant-email">Email</label>
                        <input id="applicant-email" name="email" type="email" autocomplete="email" maxlength="254" />
                    </div>
                    <div>
                        <label for="applicant-phone">Callback number</label>
                        <input id="applicant-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
                    </div>
                </div>

                <label for="trailer-type">Trailer type (optional)</label>
                <select id="trailer-type" name="trailerType">
                    <option value="">Select…</option>
                    {["Dry van", "Flatbed", "Reefer", "Power only", "Other"].map((type) => <option value={type}>{type}</option>)}
                </select>

                <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY} data-action="turnstile-spin-v1"></div>
                <button type="submit" class="primary-cta">Send my application</button>
            </form>
            <p id="confirmation-message" role="status" aria-live="polite"></p>
        </section>
        <QuestionPopup />
    </main>
    <script>
        import "../sign-up-form/sign-up.js";
    </script>
</BaseLayout>
