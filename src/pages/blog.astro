---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../normalize.css";
import "../shared.css";
import "../blog/blog.css";
import { loadArticles, formatDate, siteUrl } from "../lib/articles.js";

const articles = await loadArticles();
---

<BaseLayout
    title="Blog | Iron Wing Dispatching"
    description="Trucking insights from Iron Wing Dispatching."
    canonical={`${siteUrl}/blog.html`}
>
    <Fragment slot="head">
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Iron Wing Dispatching Blog"
            href={`${siteUrl}/rss.xml`}
        />
    </Fragment>
    <main>
        <section class="blog">
            <div class="container">
                <h1>Blog</h1>
                {
                    articles.map((article) => (
                        <article>
                            <h2>
                                <a href={`/blog/${article.slug}.html`}>
                                    {article.title}
                                </a>
                            </h2>
                            <div class="article-meta">
                                <time datetime={article.date}>
                                    {formatDate(article)}
                                </time>
                            </div>
                            <p>{article.description}</p>
                            <a href={`/blog/${article.slug}.html`}>
                                Read article
                            </a>
                        </article>
                    ))
                }
            </div>
        </section>
    </main>
</BaseLayout>
